	file = {Full Text PDF:C\:\\Users\\nolan\\Zotero\\storage\\32AFSS22\\Li et al. - 2019 - Quantitative Characteristic Comparison between Sensorless Six Step and Field Oriented Control Method.pdf:application/pdf},
