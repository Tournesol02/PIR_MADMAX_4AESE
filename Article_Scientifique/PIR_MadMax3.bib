	file = {PDF:C\:\\Users\\nolan\\Zotero\\storage\\JV793P7X\\M et al. - 2025 - Speed Control of Six Step Commutation Trapezoidal by Fuzzy Logic Control of BLDC Motor for E-Vehicle.pdf:application/pdf},
